<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.AnchorPane?>
<BorderPane fx:controller="com.example.fantasysortinggame.gamephasemanager.SalePhaseController"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="600" prefHeight="400">

    <!-- TOP: Day/Gold Labels + Filter Buttons -->
    <top>
        <VBox spacing="5" alignment="CENTER">
            <Label fx:id="dayLabel" text="Day: 0"/>
            <Label fx:id="totalGoldLabel" text="Gold: 0"/>
            <!-- Dynamic filter buttons container -->
            <HBox fx:id="filterButtonContainer" spacing="10" alignment="CENTER"/>
        </VBox>
    </top>

    <!-- CENTER: Items container -->
    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="itemContainer" spacing="10" prefWidth="350" prefHeight="300"/>
        </ScrollPane>
    </center>

    <!-- BOTTOM: Proceed Button -->
    <bottom>
        <VBox spacing="5" alignment="CENTER">
            <!-- Dialogue placeholder -->
            <AnchorPane fx:id="dialogueContainer" prefHeight="100"/>

            <!-- End Phase button -->
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="proceedButton" text="End Phase"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
