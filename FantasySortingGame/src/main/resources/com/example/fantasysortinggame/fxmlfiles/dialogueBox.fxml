<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" fx:controller="com.example.fantasysortinggame.storyhandlers.DialogueBoxController"
            prefWidth="600" prefHeight="200"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

   <HBox layoutX="0" layoutY="0" prefWidth="600" prefHeight="200" spacing="10" style="-fx-padding: 10;">

      <!-- Character Image -->
      <ImageView fx:id="imageView" fitWidth="150" fitHeight="150" preserveRatio="true"/>

      <!-- Dialogue Info -->
      <VBox spacing="10">
         <Label fx:id="nameLabel" text="Name" style="-fx-font-weight: bold; -fx-font-size: 16;" />
         <Label fx:id="dialogueLabel" text="Dialogue goes here..." wrapText="true" prefWidth="400"/>
         <Button fx:id="continueButton" text="Continue" prefWidth="100"/>
      </VBox>

   </HBox>

</AnchorPane>
