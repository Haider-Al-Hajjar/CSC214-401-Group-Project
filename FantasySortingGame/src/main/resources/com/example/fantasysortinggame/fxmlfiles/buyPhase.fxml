<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<BorderPane fx:controller="com.example.fantasysortinggame.phasecontrollers.BuyPhaseController"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="600" prefHeight="400">
   <top>
      <VBox spacing="5" BorderPane.alignment="CENTER">
         <Label fx:id="dayLabel" text="Day: 0"/>
         <Label fx:id="totalGoldLabel" text="Gold: 0"/>
      </VBox>
   </top>

   <!-- CENTER: Scrollable upgrade list -->
   <center>
      <ScrollPane fitToWidth="true">
         <VBox fx:id="shopContainer" spacing="10" style="-fx-padding: 10;"/>
      </ScrollPane>
   </center>

   <!-- BOTTOM: Proceed button aligned left -->
   <bottom>
      <HBox spacing="10" style="-fx-padding: 10;">
         <Button fx:id="proceedButton"
                 text="End Day."
                 prefWidth="120"/>
      </HBox>
   </bottom>

</BorderPane>
