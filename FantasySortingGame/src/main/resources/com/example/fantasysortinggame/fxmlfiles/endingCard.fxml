<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.fantasysortinggame.mainmenu.EndingCardController"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: #2b2b2b; -fx-padding: 30px;">

    <Label fx:id="endingTitle" text="ENDING TITLE"
           style="-fx-font-size: 28px; -fx-text-fill: white;" />

    <Label fx:id="endingDescription" text="Here is the ending description."
           wrapText="true"
           style="-fx-font-size: 16px; -fx-text-fill: white;" />

    <Button fx:id="closeButton" text="Close"
            style="-fx-font-size: 14px; -fx-padding: 8px 16px;" />

</VBox>
